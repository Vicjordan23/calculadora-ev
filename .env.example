# Sin estas dos variables, la app usa un fichero SQLite local en data/app.db
# (perfecto para desarrollo en tu PC). En produccion (Render), copia aqui los
# valores que te da turso.tech al crear la base de datos.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Render define PORT automaticamente; solo hace falta en local si quieres
# cambiar el puerto por defecto (3000).
# PORT=3000
